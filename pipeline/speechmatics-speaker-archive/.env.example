# Создайте случайную длинную строку, например: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-with-a-long-random-secret

# Можно оставить пустым и сохранить ключ через веб-интерфейс.
SPEECHMATICS_API_KEY=
SPEECHMATICS_BASE_URL=https://eu1.asr.api.speechmatics.com/v2

# Общий ключ для извлечения структуры игр, Voyage-эмбеддингов и RAG.
# Не добавляйте реальный ключ в репозиторий.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ENRICHMENT_MODEL=inclusionai/ling-3.0-flash:free
ENRICHMENT_VERIFIER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
ENRICHMENT_ESCALATION_MODEL=openai/gpt-5.6-luna
ENRICHMENT_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
RAG_ANSWER_MODEL=inclusionai/ling-3.0-flash:free
EMBEDDING_MODEL=voyageai/voyage-4
EMBEDDING_DIMENSIONS=1024

# Локальный запуск использует значения по умолчанию ниже.
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///data/app.db
STORAGE_DIR=storage
WORKER_POLL_SECONDS=10
FOLDER_SCAN_INTERVAL_SECONDS=60
KEEP_PREPARED_AUDIO=false

# Только для Docker Compose: папка с WAV на хосте.
AUDIO_ROOT=./audio
